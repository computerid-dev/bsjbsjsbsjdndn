# GEMINI_API_KEY dipakai server.ts untuk fitur scan foto (isi di server, jangan di frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: alamat server tempat /api/scan-photo di-host
APP_URL="MY_APP_URL"

# VITE_API_BASE: dipakai build APK supaya scan foto memanggil server online.
# Kosongkan kalau tidak ada fitur scan. Contoh: https://kaloriku.vercel.app
VITE_API_BASE=""
